<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_auto_po_receipt_bill" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auto.po.receipt.bill</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Auto Receipt and Bill" name="auto_po_receipt_bill_block">
                    <setting id="auto_po_receipt_bill_setting"
                             string="Auto receive and bill on PO confirmation"
                             help="On Confirm Order: validate the receipt with the demanded quantity and post the vendor bill.">
                        <field name="auto_po_receipt_bill"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
